# Copy file ini menjadi BackEnd/.env. Jangan bagikan file .env berisi password

# Server
PORT=7777

# Database
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=GANTI_DENGAN_PASSWORD_MYSQL
DB_NAME=senseresq

# Serial (sesuaikan dengan port laptop posko)
SERIAL_PORT=COM3
SERIAL_BAUD=115200

# Bounding box area bencana (sesuaikan dengan lokasi bencana)
BBOX_MIN_LAT=-6.3850
BBOX_MAX_LAT=-6.3450
BBOX_MIN_LNG=106.8150
BBOX_MAX_LNG=106.8400

# true hanya untuk simulasi data, false untuk hardware nyata
MOCK_MODE=false